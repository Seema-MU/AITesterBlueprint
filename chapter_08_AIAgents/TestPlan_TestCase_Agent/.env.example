# Template only. Copy to .env and fill in - never put real credentials here.
# .env is gitignored; this file is NOT, so anything typed below can be committed.
#
#   copy .env.example .env

# --- Jira Cloud ---
# Base URL of your site, e.g. https://your-domain.atlassian.net
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
# Create at id.atlassian.com -> Security -> API tokens (starts with ATATT3)
JIRA_TOKEN=your-atlassian-api-token
# Shown as "Prepared By" in the generated plan
QA_NAME=Your Name

# --- Groq (recommended provider) ---
# Create at console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=
# Verify the model against GET /openai/v1/models for your account.
# llama-3.3-70b-versatile has been RETIRED and returns model_not_found.
GROQ_MODEL=openai/gpt-oss-120b

# --- Local LLM (optional fallback; LM Studio or Ollama, OpenAI-compatible) ---
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=google/gemma-3-1b
